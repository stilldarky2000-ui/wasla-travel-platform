# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_MAPS_PLATFORM_KEY: Automatically provisioned & injected by AI Studio for Google Maps.
# Only set manually if replacing the Demo Key with your own billed Google Cloud Maps key.
# GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# ==============================================================================
# OFFICIAL BOOKING EMAIL DELIVERY (Owner Inbox — e.g. booking@waslatravel.com)
# Configure EITHER Standard Domain SMTP (Hostinger, cPanel, GoDaddy, Zoho, Google Workspace)
# OR Resend API in AI Studio Settings > Secrets.
# ==============================================================================
# OWNER_ALERT_EMAIL="booking@waslatravel.com"
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="booking@waslatravel.com"
# SMTP_PASS="YOUR_EMAIL_PASSWORD_OR_APP_PASSWORD"
# SMTP_FROM="Wasla Travel Bookings <booking@waslatravel.com>"

# Alternative transactional email API (if not using SMTP):
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
# RESEND_FROM_EMAIL="Wasla Travel <booking@waslatravel.com>"

# ==============================================================================
# AUTOMATIC OWNER WHATSAPP ALERTS ON EVERY NEW BOOKING
# Configure ONE of the options below in AI Studio Settings > Secrets:
# ==============================================================================
# OWNER_WHATSAPP_TO="201129155520"

# Option 1 (Official Meta WhatsApp Cloud API):
# WHATSAPP_CLOUD_TOKEN="YOUR_META_PERMANENT_TOKEN"
# WHATSAPP_PHONE_NUMBER_ID="YOUR_PHONE_NUMBER_ID"

# Option 2 (Twilio WhatsApp API):
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Option 3 (CallMeBot Free Personal WhatsApp Push Alert):
# CALLMEBOT_API_KEY="YOUR_CALLMEBOT_API_KEY"

# Option 4 (Optional Webhook for Make.com / Zapier / n8n):
# OWNER_ALERT_WEBHOOK_URL="https://hook.eu2.make.com/xxxxxxxx"
